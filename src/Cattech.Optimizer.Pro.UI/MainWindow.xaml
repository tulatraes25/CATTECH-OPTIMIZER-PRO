<Window x:Class="Cattech.Optimizer.Pro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cattech.Optimizer.Pro.UI.ViewModels"
        xmlns:converters="clr-namespace:Cattech.Optimizer.Pro.UI.Converters"
        Title="CATTECH OPTIMIZER PRO"
        Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Atajos globales: F5 = acción principal de la sección actual;
         Ctrl+0 = Inicio; Ctrl+1..9 = primeras 9 secciones. -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCurrentSectionCommand}" />

        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="7" />
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="8" />
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="9" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="0" />

        <KeyBinding Key="NumPad1" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="1" />
        <KeyBinding Key="NumPad2" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="2" />
        <KeyBinding Key="NumPad3" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="3" />
        <KeyBinding Key="NumPad4" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="4" />
        <KeyBinding Key="NumPad5" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="5" />
        <KeyBinding Key="NumPad6" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="6" />
        <KeyBinding Key="NumPad7" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="7" />
        <KeyBinding Key="NumPad8" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="8" />
        <KeyBinding Key="NumPad9" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="9" />
        <KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{Binding NavigateByShortcutCommand}" CommandParameter="0" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:AdminColorConverter x:Key="AdminColor" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Entrada del menú lateral: compacta, con atajo visible. -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D8D8D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C8C8C8" />
                            </Trigger>
                            <!-- La sección activa mantiene el resaltado aunque el mouse esté encima. -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones planos de la barra de estado (densos, tipo link técnico). -->
        <Style x:Key="StatusBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0067B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0C0C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#E8E8E8">
                <DockPanel>
                    <!-- Header compacto -->
                    <Border DockPanel.Dock="Top"
                            Background="#0078D4"
                            Height="48"
                            Padding="12,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CATTECH"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock Text="OPTIMIZER PRO · v0.3.1"
                                       FontSize="10"
                                       Foreground="#B0D4F1" />
                        </StackPanel>
                    </Border>

                    <!-- Secciones con atajo Ctrl+0..9 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NavigationItems}"
                                      Margin="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="27"
                                            ToolTip="{Binding ToolTip}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Section}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Shortcut}"
                                                       Margin="8,0,0,0"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Visibility="{Binding Shortcut, Converter={StaticResource StringToVis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Contenido principal -->
            <Border Grid.Column="1" Background="White">
                <ContentControl Content="{Binding CurrentView}"
                                Margin="0" />
            </Border>
        </Grid>

        <!-- Barra de estado global: elevación, entorno, datos, smartctl, versión. -->
        <Border Grid.Row="1"
                Background="#E8E8E8"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Elevación -->
                <TextBlock Grid.Column="0"
                           Text="{Binding AdminText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{Binding IsAdministrator, Converter={StaticResource AdminColor}}"
                           ToolTip="Environment.IsPrivilegedProcess: si el proceso corre elevado" />

                <!-- Windows build · arquitectura · runtime -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="·" Margin="6,0" Foreground="#999" />
                    <TextBlock Text="{Binding OsLine}"
                               FontSize="11"
                               Foreground="#555"
                               VerticalAlignment="Center"
                               ToolTip="{Binding OsLine}" />
                </StackPanel>

                <!-- Ruta de datos (truncada, tooltip con ruta completa) -->
                <Grid Grid.Column="2" Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="datos:"
                               FontSize="11"
                               Foreground="#777"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding AppBaseDirectory}"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#333"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AppBaseDirectory}" />
                    <Button Grid.Column="2"
                            Content="Abrir datos"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding OpenAppDataFolderCommand}"
                            ToolTip="Abrir el directorio de datos de la aplicación en el Explorador" />
                    <Button Grid.Column="3"
                            Content="Copiar"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding CopyToClipboardCommand}"
                            CommandParameter="{Binding AppBaseDirectory}"
                            ToolTip="Copiar la ruta completa del directorio de datos en el portapapeles" />
                </Grid>

                <!-- smartctl · versión · información -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="·" Margin="0,0,6,0" Foreground="#999" />
                    <TextBlock Text="{Binding SmartctlStatusText}"
                               FontFamily="Consolas"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{Binding SmartctlStatusBrush}"
                               ToolTip="{Binding SmartctlStatusDetail}" />
                    <Button Content="Configurar"
                            Style="{StaticResource StatusBarButton}"
                            Margin="4,0,0,0"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            ToolTip="Ir a Configuración › Herramientas externas (smartctl)" />
                    <TextBlock Text="·" Margin="8,0,6,0" Foreground="#999" />
                    <TextBlock Text="{Binding AppVersionText}"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#555"
                               VerticalAlignment="Center"
                               ToolTip="Versión del ensamblado de UI" />
                    <Button Content="Información"
                            Style="{StaticResource StatusBarButton}"
                            Margin="4,0,0,0"
                            Command="{Binding ShowAppInfoCommand}"
                            ToolTip="Rutas de config, datos y logs; modo portable/instalado; runtime" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
