<UserControl x:Class="Cattech.Optimizer.Pro.UI.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Cattech.Optimizer.Pro.UI.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvertBoolToVis" />
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:NullableTemperatureConverter x:Key="TempConverter" />
        <converters:NullableNumberConverter x:Key="NumConverter" />
        <converters:PerformanceMetricTypeTextConverter x:Key="PerfMetricConverter" />
        <converters:BatteryMetricTypeTextConverter x:Key="BatteryMetricConverter" />
        <converters:EmptyStringToNdConverter x:Key="EmptyToNd" />
        <converters:PositiveNumberOrNdConverter x:Key="PosNumToNd" />
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Titulo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Hardware" FontSize="26" FontWeight="Bold" Foreground="#1B1B1B" />
            <TextBlock Text="Monitoreo de hardware en tiempo real" FontSize="13" Foreground="#666"
                       Margin="0,5,0,0" />
            <TextBlock Text="Lectura mediante LibreHardwareMonitor - solo lectura" FontSize="11" Foreground="#888"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Row 1: Controles + estado -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Actualizar una vez" Padding="14,8"
                    Command="{Binding RefreshCommand}" />
            <Button Grid.Column="2" Content="Iniciar monitoreo" Padding="14,8"
                    Command="{Binding StartMonitoringCommand}" />
            <Button Grid.Column="4" Content="Detener" Padding="14,8"
                    Command="{Binding StopMonitoringCommand}" />

            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Estado:" FontSize="12" Foreground="#555" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#1B1B1B" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding LastUpdatedText}" FontSize="11" Foreground="#777" Margin="0,3,0,0"
                           Visibility="{Binding LastUpdatedText, Converter={StaticResource StringToVis}}" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Modo administrador:" FontSize="11" Foreground="#555" />
                    <TextBlock Text="{Binding AdminText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Row 2: Hint inicial -->
        <TextBlock Grid.Row="2" Text="Presione 'Actualizar una vez' o 'Iniciar monitoreo'."
                   FontSize="12" Foreground="#888" Margin="0,0,0,12" />

        <!-- Row 3: Resumen compacto por familia -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Background="White" Margin="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="Temperaturas" FontSize="11" Foreground="#555" />
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,3,0,0">
                        <Run Text="{Binding SensorCountText}" /><Run Text=" sensores" FontSize="11" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Background="White" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="CPU / GPU" FontSize="11" Foreground="#555" />
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,3,0,0">
                        <Run Text="{Binding PerformanceSensorCount}" /><Run Text=" sensores" FontSize="11" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Background="White" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Memoria GPU" FontSize="11" Foreground="#555" />
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,3,0,0">
                        <Run Text="{Binding GpuMemorySensorCount}" /><Run Text=" sensores" FontSize="11" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Background="White" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Bateria" FontSize="11" Foreground="#555" />
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,3,0,0">
                        <Run Text="{Binding BatterySensorCount}" /><Run Text=" sensores" FontSize="11" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Background="White" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="RAM SPD" FontSize="11" Foreground="#555" />
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,3,0,0">
                        <Run Text="{Binding MemoryTimingSensorCount}" /><Run Text=" sensores" FontSize="11" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 4: Warnings y Errors -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                    Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="1"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#E65100"
                                       TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                    Background="#FDECEA" BorderBrush="#D93025" BorderThickness="1"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#C62828"
                                       TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- Row 5: Pestanas live + inventario -->
        <TabControl Grid.Row="5" Background="White" BorderBrush="#E0E0E0">
            <!-- Pestana Temperaturas -->
            <TabItem Header="Temperaturas">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="No se detectaron sensores de temperatura disponibles."
                               FontSize="12" Foreground="#888" Margin="0,0,0,6"
                               Visibility="{Binding HasSensors, Converter={StaticResource InvertBoolToVis}}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TemperatureSensors}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding HardwareType}" Width="110" />
                            <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="*" />
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="180" />
                            <DataGridTextColumn Header="Actual" Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ValueCelsius" Converter="{StaticResource TempConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Min." Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="MinCelsius" Converter="{StaticResource TempConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Max." Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="MaxCelsius" Converter="{StaticResource TempConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Pestana CPU / GPU -->
            <TabItem Header="CPU / GPU">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="No se detectaron metricas dinamicas disponibles."
                               FontSize="12" Foreground="#888" Margin="0,0,0,6"
                               Visibility="{Binding PerformanceSensorCount, Converter={StaticResource ZeroToVis}}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PerformanceSensors}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding HardwareType}" Width="70" />
                            <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="*" />
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="160" />
                            <DataGridTextColumn Header="Metrica" Binding="{Binding MetricType, Converter={StaticResource PerfMetricConverter}}" Width="90" />
                            <DataGridTextColumn Header="Actual" Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Value" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Min." Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Min" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Max." Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Max" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Pestana Memoria GPU -->
            <TabItem Header="Memoria GPU">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="No se detectaron sensores de memoria GPU disponibles."
                               FontSize="12" Foreground="#888" Margin="0,0,0,6"
                               Visibility="{Binding GpuMemorySensorCount, Converter={StaticResource ZeroToVis}}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding GpuMemorySensors}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPU" Binding="{Binding HardwareName}" Width="*" />
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="180" />
                            <DataGridTextColumn Header="Actual" Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ValueMB" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Min." Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="MinMB" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Max." Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="MaxMB" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Pestana Bateria -->
            <TabItem Header="Bateria">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="No se detecto telemetria de bateria aplicable."
                               FontSize="12" Foreground="#888" Margin="0,0,0,6"
                               Visibility="{Binding BatterySensorCount, Converter={StaticResource ZeroToVis}}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding BatterySensors}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bateria" Binding="{Binding HardwareName}" Width="*" />
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="180" />
                            <DataGridTextColumn Header="Metrica" Binding="{Binding MetricType, Converter={StaticResource BatteryMetricConverter}}" Width="80" />
                            <DataGridTextColumn Header="Actual" Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Value" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Min." Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Min" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Max." Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Max" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Pestana RAM SPD -->
            <TabItem Header="RAM SPD">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="No se detectaron timings SPD disponibles."
                               FontSize="12" Foreground="#888" Margin="0,0,0,6"
                               Visibility="{Binding MemoryTimingSensorCount, Converter={StaticResource ZeroToVis}}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding MemoryTimingSensors}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Modulo SPD" Binding="{Binding HardwareName}" Width="*" />
                            <DataGridTextColumn Header="Timing" Binding="{Binding SensorName}" Width="200" />
                            <DataGridTextColumn Header="Actual" Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ValueNanoseconds" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Min." Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="MinNanoseconds" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Max." Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="MaxNanoseconds" Converter="{StaticResource NumConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Pestana Inventario (B.4.2) -->
            <TabItem Header="Inventario">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,12,12">
                        <!-- Cabecera del inventario -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Actualizar inventario" Padding="14,8"
                                    Command="{Binding RefreshInventoryCommand}" />
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Estado:" FontSize="12" Foreground="#555" />
                                    <TextBlock Text="{Binding InventoryStatusText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1B1B1B" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding InventoryLastUpdatedText}" FontSize="11" Foreground="#777"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding InventoryLastUpdatedText, Converter={StaticResource StringToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                Background="#FDECEA" BorderBrush="#D93025" BorderThickness="1"
                                Visibility="{Binding HasInventoryErrors, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding InventoryErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#C62828"
                                                   TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Hint inicial -->
                        <TextBlock Text="Presione 'Actualizar inventario' para leer CPU, GPU, RAM y placa madre."
                                   FontSize="12" Foreground="#888" Margin="0,0,0,10"
                                   Visibility="{Binding IsInventoryLoaded, Converter={StaticResource InvertBoolToVis}}" />

                        <StackPanel Visibility="{Binding IsInventoryLoaded, Converter={StaticResource BoolToVis}}">

                            <!-- CPU -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Background="White" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="12" Foreground="#555" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Cpu.Name, Converter={StaticResource EmptyToNd}}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fabricante:" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cpu.Manufacturer, Converter={StaticResource EmptyToNd}}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Nucleos / Hilos:" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Cpu.Cores, Converter={StaticResource PosNumToNd}}" FontSize="12" />
                                            <TextBlock Text=" / " FontSize="12" Foreground="#888" />
                                            <TextBlock Text="{Binding Cpu.Threads, Converter={StaticResource PosNumToNd}}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Velocidad reportada (GHz):" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Cpu.BaseSpeedGHz, Converter={StaticResource PosNumToNd}}" FontSize="12" Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- GPU -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Background="White" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="GPU" FontSize="13" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,8" />
                                    <TextBlock Text="No se detecto informacion estatica de GPU disponible."
                                               FontSize="12" Foreground="#888" Margin="0,0,0,6"
                                               Visibility="{Binding Gpus.Count, Converter={StaticResource ZeroToVis}}" />
                                    <DataGrid ItemsSource="{Binding Gpus}" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal"
                                              Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                              AlternatingRowBackground="#FAFAFA">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="GPU" Binding="{Binding Name, Converter={StaticResource EmptyToNd}}" Width="*" />
                                            <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer, Converter={StaticResource EmptyToNd}}" Width="*" />
                                            <DataGridTextColumn Header="Memoria reportada (GB)" Width="160">
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="MemoryGB" Converter="{StaticResource PosNumToNd}" />
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- RAM resumen -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Background="White" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="RAM" FontSize="13" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="RAM total (GB):" FontSize="12" Foreground="#555" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Memory.TotalGB, Converter={StaticResource PosNumToNd}}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo:" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Memory.Type, Converter={StaticResource EmptyToNd}}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Velocidad configurada (MHz):" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Memory.SpeedMHz, Converter={StaticResource PosNumToNd}}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Slots:" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Memory.SlotsUsed}" FontSize="12" />
                                            <TextBlock Text=" / " FontSize="12" Foreground="#888" />
                                            <TextBlock Text="{Binding Memory.SlotsTotal}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Modulos RAM -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Background="White" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Modulos de memoria" FontSize="13" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,8" />
                                    <TextBlock Text="No se detecto detalle de modulos RAM mediante WMI/SMBIOS."
                                               FontSize="12" Foreground="#888" Margin="0,0,0,6"
                                               Visibility="{Binding MemoryModules.Count, Converter={StaticResource ZeroToVis}}" />
                                    <DataGrid ItemsSource="{Binding MemoryModules}" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal"
                                              Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                              AlternatingRowBackground="#FAFAFA">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Slot" Binding="{Binding DeviceLocator, Converter={StaticResource EmptyToNd}}" Width="80" />
                                            <DataGridTextColumn Header="Banco" Binding="{Binding BankLabel, Converter={StaticResource EmptyToNd}}" Width="80" />
                                            <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer, Converter={StaticResource EmptyToNd}}" Width="100" />
                                            <DataGridTextColumn Header="Part number" Binding="{Binding PartNumber, Converter={StaticResource EmptyToNd}}" Width="120" />
                                            <DataGridTextColumn Header="Serie" Binding="{Binding SerialNumber, Converter={StaticResource EmptyToNd}}" Width="100" />
                                            <DataGridTextColumn Header="Capacidad (GB)" Width="90">
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="CapacityGB" Converter="{StaticResource PosNumToNd}" />
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Velocidad (MHz)" Width="90">
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="ConfiguredClockSpeedMHz" Converter="{StaticResource PosNumToNd}" />
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding MemoryType, Converter={StaticResource EmptyToNd}}" Width="90" />
                                            <DataGridTextColumn Header="Data width" Width="80">
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="DataWidthBits" Converter="{StaticResource PosNumToNd}" />
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Total width" Width="80">
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="TotalWidthBits" Converter="{StaticResource PosNumToNd}" />
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Rank" Width="60">
                                                <DataGridTextColumn.Binding>
                                                    <Binding Path="Rank" Converter="{StaticResource PosNumToNd}" />
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Placa madre / BIOS -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Background="White">
                                <StackPanel>
                                    <TextBlock Text="Placa madre / BIOS" FontSize="13" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fabricante:" FontSize="12" Foreground="#555" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Motherboard.Manufacturer, Converter={StaticResource EmptyToNd}}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Modelo:" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Motherboard.Model, Converter={StaticResource EmptyToNd}}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="BIOS:" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Motherboard.BiosVersion, Converter={StaticResource EmptyToNd}}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha BIOS:" FontSize="12" Foreground="#555" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Margin="0,4,0,0"
                                                   Text="{Binding Motherboard.BiosDate, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='N/D'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
