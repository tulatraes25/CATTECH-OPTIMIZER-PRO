<UserControl x:Class="Cattech.Optimizer.Pro.UI.Views.RepairCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Centro de reparación — preparación"
                       FontSize="25" FontWeight="Bold" Foreground="#222222"
                       Margin="0,0,0,6" />
            <TextBlock Text="Esta pantalla solo consulta información y muestra planes. No ejecuta SFC, DISM, reinicios de servicios ni reparaciones de Windows Update."
                       TextWrapping="Wrap" Foreground="#555555"
                       FontSize="13" Margin="0,0,0,14" />
            <Border Background="#FFF2DC" Padding="12" CornerRadius="6"
                    Margin="0,0,0,22">
                <TextBlock Text="EJECUCIÓN DESHABILITADA. Diagnosticar y respaldar primero; cualquier reparación futura requerirá autorización explícita."
                           Foreground="#775100" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="1. Windows Update — observación"
                       FontSize="19" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Text="Un servicio detenido puede ser normal. Estos datos NO prueban la salud de Windows Update."
                       Foreground="#666666" TextWrapping="Wrap"
                       Margin="0,0,0,10" />
            <Button Content="Consultar servicios (solo lectura)"
                    Command="{Binding InspectWindowsUpdateCommand}"
                    Padding="14,8" HorizontalAlignment="Left"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0" Margin="0,0,0,10" />
            <TextBlock Text="{Binding UpdateStatusText}"
                       TextWrapping="Wrap" Foreground="#333333"
                       Margin="0,0,0,10" />
            <DataGrid ItemsSource="{Binding UpdateServices}" Height="170"
                      IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" Margin="0,0,0,24">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Servicio" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" Width="3*"/>
                    <DataGridTextColumn Header="Inicio" Binding="{Binding StartModeText}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="2. SFC / DISM — planes fijos"
                       FontSize="19" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Text="Seleccioná una operación para ver su comando, impacto y requisitos. Los análisis pueden generar logs del sistema. Las reparaciones modifican Windows."
                       Foreground="#666666" TextWrapping="Wrap"
                       Margin="0,0,0,10" />
            <ListBox ItemsSource="{Binding Plans}"
                     SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                     DisplayMemberPath="DisplayName"
                     Height="140" Margin="0,0,0,12" />

            <StackPanel DataContext="{Binding SelectedPlan}"
                        Margin="0,0,0,12">
                <TextBlock Text="{Binding CommandPreview, StringFormat='Comando previsto: {0}'}"
                           TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ImpactText}"
                           Foreground="#994400" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="{Binding SafetyNote}"
                           Foreground="#555555" TextWrapping="Wrap"
                           Margin="0,5,0,0" />
                <TextBlock Text="{Binding NetworkText}"
                           Foreground="#555555" TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
            <Button Content="Revisar requisitos del plan (sin ejecutar)"
                    Command="{Binding InspectSelectedPlanCommand}"
                    Padding="14,8" HorizontalAlignment="Left"
                    Background="#F0F0F0" Foreground="#333333"
                    BorderBrush="#AAAAAA" BorderThickness="1"
                    Margin="0,0,0,10" />
            <TextBlock Text="{Binding PreflightStatusText}"
                       TextWrapping="Wrap" Foreground="#333333" Margin="0,0,0,20" />
            <TextBlock Text="No se ejecutan comandos, no se cambian servicios, no se descarga software y no se reinicia Windows desde esta pantalla."
                       Foreground="#777777" TextWrapping="Wrap"
                       FontSize="12" Margin="0,0,0,10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
