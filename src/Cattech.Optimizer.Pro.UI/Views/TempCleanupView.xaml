<UserControl x:Class="Cattech.Optimizer.Pro.UI.Views.TempCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Cattech.Optimizer.Pro.UI.Converters"
             xmlns:cleanup="clr-namespace:Cattech.Optimizer.Pro.Core.Models.Cleanup;assembly=Cattech.Optimizer.Pro.Core"
             xmlns:vm="clr-namespace:Cattech.Optimizer.Pro.UI.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InvertBoolConverter x:Key="InvertBool" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvertBoolToVis" />
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:RiskColorConverter x:Key="RiskColorConverter" />

        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style x:Key="TechButton" TargetType="Button">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="BorderBrush" Value="#CCC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="TechLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#555" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Título técnico compacto -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Limpieza Segura de Temporales" FontSize="20" FontWeight="Bold" Foreground="#1B1B1B" />
                <TextBlock Text="  ·  ubicaciones predefinidas y escaneadas" FontSize="11" Foreground="#777"
                           VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Row 1: Mensajes -->
        <StackPanel Grid.Row="1">
            <Border CornerRadius="4" Padding="10,7" Margin="0,0,0,6"
                    Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}"
                    Background="#E6F4EA" BorderBrush="#34A853" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E7E34" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <Border CornerRadius="4" Padding="10,7" Margin="0,0,0,6"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="#FDECEA" BorderBrush="#D93025" BorderThickness="1">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Row 2: Botones principales -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Escanear temporales"
                    Command="{Binding ScanCommand}" Padding="12,6" FontSize="11" FontWeight="SemiBold"
                    Background="#0078D4" Foreground="White" BorderThickness="0"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />

            <Button Grid.Column="2" Content="Limpiar seleccionados"
                    Command="{Binding CleanupWithConfirmationCommand}" Padding="12,6" FontSize="11" FontWeight="SemiBold"
                    Background="#E53935" Foreground="White" BorderThickness="0"
                    ToolTip="Pide confirmación con la cantidad exacta de archivos antes de eliminar."
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />

            <Button Grid.Column="4" Content="Seleccionar bajos riesgo" Style="{StaticResource TechButton}"
                    Command="{Binding SelectAllLowRiskCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />

            <Button Grid.Column="6" Content="Limpiar selección" Style="{StaticResource TechButton}"
                    Command="{Binding DeselectAllCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />

            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedTargetsCount}" FontSize="13" FontWeight="Bold" Foreground="#333" Margin="0,0,4,0" />
                <TextBlock Text="seleccionados ·" FontSize="11" Foreground="#666" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalSelectedSize}" FontSize="13" FontWeight="Bold" Foreground="#E65100" />
            </StackPanel>
        </Grid>

        <!-- Row 3: Confirmación explícita y progreso -->
        <StackPanel Grid.Row="3" Margin="0,0,0,6">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#A13B24" TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="🔒 Se pedirá confirmación con la cantidad exacta de archivos antes de eliminar. Esta acción no crea copia de seguridad y no se puede deshacer." />
            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                         Height="5" Background="#E0E0E0" Foreground="#0078D4"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Row 4: Contenido principal -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: Lista de targets -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="0,0,8,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="UBICACIONES DETECTADAS" FontSize="10" FontWeight="Bold" Foreground="#0078D4" />
                        <TextBlock Text="{Binding Targets.Count, StringFormat='  ({0})'}" FontSize="10" Foreground="#777" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Ejecutá un escaneo primero" FontSize="11" Foreground="#999"
                               Visibility="{Binding HasScanned, Converter={StaticResource InvertBoolToVis}}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Targets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type cleanup:TempCleanupTarget}">
                                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,5" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Top" Margin="0,2,8,0"
                                                      Command="{Binding DataContext.ToggleTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      ToolTip="{Binding ScanNotes}">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAccessible}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsScanned}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>

                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" CornerRadius="2" Padding="5,1"
                                                            Background="{Binding RiskLevel, Converter={StaticResource RiskColorConverter}}">
                                                        <TextBlock Text="{Binding RiskLevel}" FontSize="9" Foreground="White" />
                                                    </Border>
                                                </Grid>

                                                <!-- Detalle técnico de la ubicación: ruta completa y nota en monoespaciada -->
                                                <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="10"
                                                           Foreground="#333" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#666"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           ToolTip="{Binding Description}" />
                                                <TextBlock Text="{Binding ScanNotes}" FontFamily="Consolas" FontSize="9"
                                                           Foreground="#E65100" TextWrapping="Wrap" Margin="0,1,0,0"
                                                           Visibility="{Binding ScanNotes, Converter={StaticResource StringToVis}}"
                                                           ToolTip="{Binding ScanNotes}" />

                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="10">
                                                        <Run Text="{Binding EstimatedFileCount, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text=" archivos" Foreground="#888" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" FontSize="10">
                                                        <Run Text="{Binding EstimatedSizeDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="4" FontSize="9" Foreground="#999"
                                                               Text="{Binding Id}" FontFamily="Consolas" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Panel derecho: Resultado -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                    Padding="10" Background="#FAFAFA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="RESULTADO" FontSize="10" FontWeight="Bold"
                                   Foreground="#0078D4" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding ResultSummary}" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding ResultDetails}" FontSize="10" Foreground="#666"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Archivos eliminados:" Style="{StaticResource TechLabel}" />
                                <TextBlock Text="{Binding ResultDeletedFiles}" FontSize="10" FontWeight="SemiBold" Foreground="#2E7D32" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Espacio liberado:" Style="{StaticResource TechLabel}" />
                                <TextBlock Text="{Binding ResultDeletedSize}" FontSize="10" FontWeight="SemiBold" Foreground="#2E7D32" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Omitidos:" Style="{StaticResource TechLabel}" />
                                <TextBlock Text="{Binding ResultSkippedFiles}" FontSize="10" FontWeight="SemiBold" Foreground="#E65100" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Con error:" Style="{StaticResource TechLabel}" />
                                <TextBlock Text="{Binding ResultFailedFiles}" FontSize="10" FontWeight="SemiBold" Foreground="#C62828" Grid.Column="1" />
                            </Grid>
                        </StackPanel>

                        <!-- Errores de la limpieza -->
                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <TextBlock Text="ERRORES" FontSize="10" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,4"
                                       Visibility="{Binding ResultErrors.Count, Converter={StaticResource ZeroToVis}}" />
                            <ItemsControl ItemsSource="{Binding ResultErrors}" MaxHeight="130">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type cleanup:CleanupError}">
                                        <Border Background="#FDECEA" CornerRadius="3" Padding="6,4" Margin="0,0,0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FilePath}" FontFamily="Consolas" FontSize="9"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}" />
                                                <TextBlock Text="{Binding Message}" FontSize="9" Foreground="#666" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Advertencias de seguridad -->
                        <Border Background="#FFF8E1" CornerRadius="4" Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Notas de seguridad" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#E65100" Margin="0,0,0,3" />
                                <TextBlock Text="• Solo se autorizan ubicaciones temporales predefinidas y escaneadas." FontSize="9" Foreground="#666" TextWrapping="Wrap" />
                                <TextBlock Text="• Los archivos temporales pueden contener datos útiles de aplicaciones." FontSize="9" Foreground="#666" TextWrapping="Wrap" />
                                <TextBlock Text="• La Papelera se vacía con la API de Windows y no se puede deshacer." FontSize="9" Foreground="#666" TextWrapping="Wrap" />
                                <TextBlock Text="• No se crea respaldo; la validación de enlaces no elimina todos los riesgos." FontSize="9" Foreground="#666" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Row 5: Historial técnico persistido -->
        <Border Grid.Row="5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                Padding="10,7" Margin="0,6,0,0" Background="White" MaxHeight="190">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HISTORIAL TÉCNICO" FontSize="10" FontWeight="Bold" Foreground="#0078D4" />
                        <TextBlock Text="{Binding HistoryStatusText}" FontSize="10" Foreground="#777" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Actualizar historial" Style="{StaticResource TechButton}"
                                Command="{Binding LoadHistoryCommand}"
                                IsEnabled="{Binding IsLoadingHistory, Converter={StaticResource InvertBool}}" />
                        <Button Content="Abrir carpeta de resultados" Style="{StaticResource TechButton}"
                                Command="{Binding OpenResultsFolderCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRows}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" AlternatingRowBackground="#FAFAFA"
                          BorderThickness="0" RowHeaderWidth="0" CanUserAddRows="False"
                          FontFamily="Consolas" FontSize="10" RowHeight="20">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}" />
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding StartedAtDisplay}" Width="130" />
                        <DataGridTextColumn Header="MB liberados" Binding="{Binding DeletedMBDisplay}" Width="100" />
                        <DataGridTextColumn Header="Archivos" Binding="{Binding DeletedFilesDisplay}" Width="80" />
                        <DataGridTextColumn Header="Advertencias" Binding="{Binding WarningsDisplay}" Width="100" />
                        <DataGridTextColumn Header="Archivo de registro" Binding="{Binding FileNameDisplay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
