<UserControl x:Class="Cattech.Optimizer.Pro.UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Cattech.Optimizer.Pro.UI.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InvertBoolConverter x:Key="InvertBool" />
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Informe Técnico" FontSize="26" FontWeight="Bold" Foreground="#1B1B1B" />
            <TextBlock Text="Generá un informe HTML profesional con todos los datos del servicio."
                       FontSize="13" Foreground="#666" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Row 1: Mensajes -->
        <StackPanel Grid.Row="1">
            <!-- Advisory, read-only integrity warning; never offers file deletion. -->
            <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                    Visibility="{Binding HasReportInventoryWarning, Converter={StaticResource BoolToVis}}"
                    Background="#FFF4DC" BorderBrush="#B36B00" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ATENCIÓN · INTEGRIDAD DE INFORMES"
                               FontSize="12" FontWeight="Bold" Foreground="#754400"
                               Margin="0,0,0,5" />
                    <TextBlock Text="{Binding ReportInventoryMessage}" TextWrapping="Wrap"
                               FontSize="12" Foreground="#603900" />
                </StackPanel>
            </Border>
            <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                    Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}"
                    Background="#E6F4EA" BorderBrush="#34A853" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E7E34" FontWeight="SemiBold" />
            </Border>
            <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="#FDECEA" BorderBrush="#D93025" BorderThickness="1">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <!-- Row 2: Botones -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="📥 Cargar datos"
                    Command="{Binding LoadDataCommand}" Padding="16,8" FontSize="12" FontWeight="SemiBold"
                    Background="#0078D4" Foreground="White" BorderThickness="0"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />

            <Button Grid.Column="2" Content="📄 Generar informe"
                    Command="{Binding GenerateReportCommand}" Padding="16,8" FontSize="12" FontWeight="SemiBold"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />

            <Button Grid.Column="4" Content="📕 Exportar PDF"
                    Command="{Binding ExportPdfCommand}" Padding="16,8" FontSize="12" FontWeight="SemiBold"
                    Background="#E53935" Foreground="White" BorderThickness="0"
                    IsEnabled="{Binding IsExportingPdf, Converter={StaticResource InvertBool}}" />

            <Button Grid.Column="6" Content="🔗 Abrir informe"
                    Command="{Binding OpenReportCommand}" Padding="14,8" FontSize="12"
                    Background="#F3F3F3" Foreground="#333" BorderBrush="#CCC" BorderThickness="1"
                    IsEnabled="{Binding HasGeneratedReport}" />

            <Button Grid.Column="8" Content="📁 Abrir carpeta"
                    Command="{Binding OpenReportsFolderCommand}" Padding="14,8" FontSize="12"
                    Background="#F3F3F3" Foreground="#333" BorderBrush="#CCC" BorderThickness="1" />

            <TextBlock Grid.Column="10" Text="{Binding StatusText}" FontSize="12" Foreground="#666" VerticalAlignment="Center" />
        </Grid>

        <!-- Row 3: Contenido -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: Selección de datos -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- Secciones del informe -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                            Padding="15" Background="White" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SECCIONES DEL INFORME" FontSize="12" FontWeight="Bold"
                                       Foreground="#0078D4" Margin="0,0,0,10" />

                            <CheckBox Content="Datos de empresa/técnico" IsChecked="{Binding IncludeCompany}"
                                      IsEnabled="{Binding HasCompanyData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Datos del cliente/equipo" IsChecked="{Binding IncludeClient}"
                                      IsEnabled="{Binding HasClientData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Diagnóstico rápido" IsChecked="{Binding IncludeDiagnostic}"
                                      IsEnabled="{Binding HasDiagnosticData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Programas de inicio" IsChecked="{Binding IncludeStartup}"
                                      IsEnabled="{Binding HasStartupData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Limpieza de temporales" IsChecked="{Binding IncludeCleanup}"
                                      IsEnabled="{Binding HasCleanupData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Optimización visual" IsChecked="{Binding IncludeVisualOptimization}"
                                      IsEnabled="{Binding HasVisualOptimizationData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Punto de restauración" IsChecked="{Binding IncludeRestorePoint}"
                                      IsEnabled="{Binding HasRestorePointData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Estado SMART de discos" IsChecked="{Binding IncludeSmart}"
                                      IsEnabled="{Binding HasSmartData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Pruebas SMART (Self-Test)" IsChecked="{Binding IncludeSmartTests}"
                                      IsEnabled="{Binding HasSmartTestData}" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox Content="Recomendaciones automáticas" IsChecked="{Binding IncludeRecommendations}"
                                      FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- C2-C: technician review; does NOT enable mixed exports -->
                    <Border BorderBrush="#B8CBDC" BorderThickness="1" CornerRadius="6"
                            Padding="15" Background="#F3F8FC" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="REVISIÓN DE EVIDENCIA DEL EQUIPO"
                                       FontSize="12" FontWeight="Bold" Foreground="#175C8E"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Antes de asociar un diagnóstico al cliente, verificá el equipo y el origen de la medición. La coincidencia de número de serie o fecha no demuestra procedencia."
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button Content="1. Verificar diagnóstico seleccionado"
                                    Command="{Binding PreviewDiagnosticReviewCommand}"
                                    Padding="12,7" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding HasPendingSourceReview, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SourceReviewEvidence}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="Alias local del técnico (3 a 48 caracteres, letras/números/guion):"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3" />
                                <TextBox Text="{Binding ReviewerAlias, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="48" Padding="8,5" Margin="0,0,0,8"
                                         AutomationProperties.Name="Alias del técnico revisor" />
                                <CheckBox IsChecked="{Binding ReviewConsent}"
                                          Content="He revisado el caso y esta evidencia; autorizo registrar su asociación."
                                          FontSize="11" Margin="0,0,0,8" />
                                <Button Content="2. Confirmar y registrar revisión"
                                        Command="{Binding ConfirmDiagnosticReviewCommand}"
                                        Padding="12,7" HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
                            </StackPanel>
                            <TextBlock Text="Esta revisión no habilita todavía el uso combinado de mediciones en un informe de cliente."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="#526779" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Selección de datos -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                            Padding="15" Background="White" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DATOS DISPONIBLES" FontSize="12" FontWeight="Bold"
                                       Foreground="#0078D4" Margin="0,0,0,10" />

                            <!-- Cliente/Equipo -->
                            <TextBlock Text="Cliente/Equipo:" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4" />
                            <!-- Do not show indistinguishable duplicate client names:
                                 include equipment and service date, never raw serial/ID. -->
                            <ComboBox ItemsSource="{Binding AvailableServiceReports}"
                                      SelectedItem="{Binding SelectedServiceReport}"
                                      FontSize="11" Padding="8,6" Margin="0,0,0,10"
                                      IsEnabled="{Binding HasClientData}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Client.Name}"
                                                       FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Equipment.Brand}" Foreground="#666" />
                                                <TextBlock Text=" · " Foreground="#777" />
                                                <TextBlock Text="{Binding Equipment.Model}" Foreground="#666" />
                                                <TextBlock Text=" · " Foreground="#777" />
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yy HH:mm}}"
                                                           Foreground="#666" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Diagnóstico -->
                            <TextBlock Text="Diagnóstico:" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableDiagnosticReports}"
                                      SelectedItem="{Binding SelectedDiagnosticReport}"
                                      DisplayMemberPath="OsName"
                                      FontSize="11" Padding="8,6" Margin="0,0,0,10"
                                      IsEnabled="{Binding HasDiagnosticData}" />

                            <!-- Inicio -->
                            <TextBlock Text="Análisis de inicio:" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableStartupAnalyses}"
                                      SelectedItem="{Binding SelectedStartupAnalysis}"
                                      DisplayMemberPath="AnalysisDate"
                                      FontSize="11" Padding="8,6" Margin="0,0,0,10"
                                      IsEnabled="{Binding HasStartupData}" />

                            <!-- Limpieza -->
                            <TextBlock Text="Resultado de limpieza:" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableCleanupResults}"
                                      SelectedItem="{Binding SelectedCleanupResult}"
                                      DisplayMemberPath="StartedAt"
                                      FontSize="11" Padding="8,6" Margin="0,0,0,10"
                                      IsEnabled="{Binding HasCleanupData}" />

                            <!-- Punto de restauración -->
                            <TextBlock Text="Punto de restauración:" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableRestorePointResults}"
                                      SelectedItem="{Binding SelectedRestorePointResult}"
                                      DisplayMemberPath="RestorePointName"
                                      FontSize="11" Padding="8,6" Margin="0,0,0,10"
                                      IsEnabled="{Binding HasRestorePointData}" />

                            <!-- Análisis SMART -->
                            <TextBlock Text="Análisis SMART:" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableSmartAnalyses}"
                                      SelectedItem="{Binding SelectedSmartAnalysis}"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="11" Padding="8,6" Margin="0,0,0,10"
                                      IsEnabled="{Binding HasSmartData}" />

                            <!-- Self-tests SMART -->
                            <TextBlock Text="Self-tests SMART disponibles:" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4" />
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,6"
                                    Background="#FAFAFA" MaxHeight="150"
                                    Visibility="{Binding HasSmartTestData, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableSmartTestSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected}"
                                                          FontSize="10" Margin="0,2,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="Las sesiones de self-test no están vinculadas automáticamente al cliente o servicio. Seleccione únicamente las correspondientes a este informe."
                                       FontSize="9" Foreground="#999" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasSmartTestData, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Panel derecho: Observaciones + Resultado -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="15" Background="#FAFAFA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="OBSERVACIONES FINALES" FontSize="12" FontWeight="Bold"
                                   Foreground="#0078D4" Margin="0,0,0,8" />
                        <TextBox Text="{Binding FinalObservations, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                                 Padding="10,8" FontSize="12" BorderBrush="#CCC" BorderThickness="1"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" />

                        <Separator Background="#E0E0E0" Margin="0,0,0,15" />

                        <!-- Último informe -->
                        <TextBlock Text="ÚLTIMO INFORME" FontSize="12" FontWeight="Bold"
                                   Foreground="#0078D4" Margin="0,0,0,8"
                                   Visibility="{Binding HasGeneratedReport, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding LastReportPath}" FontSize="10" Foreground="#666"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasGeneratedReport, Converter={StaticResource BoolToVis}}" />

                        <Button Content="🔗 Abrir informe generado"
                                Command="{Binding OpenReportCommand}" Padding="14,8" FontSize="12"
                                Background="#E3F2FD" Foreground="#1565C0" BorderBrush="#42A5F5" BorderThickness="1"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Visibility="{Binding HasGeneratedReport, Converter={StaticResource BoolToVis}}" />

                        <!-- PDF -->
                        <TextBlock Text="ÚLTIMO PDF" FontSize="12" FontWeight="Bold"
                                   Foreground="#0078D4" Margin="0,10,0,8"
                                   Visibility="{Binding HasGeneratedPdf, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding LastPdfPath}" FontSize="10" Foreground="#666"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasGeneratedPdf, Converter={StaticResource BoolToVis}}" />

                        <Button Content="📕 Abrir PDF generado"
                                Command="{Binding OpenPdfCommand}" Padding="14,8" FontSize="12"
                                Background="#FDECEA" Foreground="#C62828" BorderBrush="#EF5350" BorderThickness="1"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Visibility="{Binding HasGeneratedPdf, Converter={StaticResource BoolToVis}}" />

                        <!-- Advertencias -->
                        <Border Background="#FFF8E1" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Notas" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#E65100" Margin="0,0,0,4" />
                                <TextBlock Text="• El informe se genera en formato HTML portátil" FontSize="10" Foreground="#666" />
                                <TextBlock Text="• El logo se embebe como base64 (portátil)" FontSize="10" Foreground="#666" />
                                <TextBlock Text="• Se guardan en reports/html/" FontSize="10" Foreground="#666" />
                                <TextBlock Text="• Las secciones sin datos se omiten automáticamente" FontSize="10" Foreground="#666" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
