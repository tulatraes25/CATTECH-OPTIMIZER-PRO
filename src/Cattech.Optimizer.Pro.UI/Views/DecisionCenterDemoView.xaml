<UserControl x:Class="Cattech.Optimizer.Pro.UI.Views.DecisionCenterDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAFBFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="CATTECH Decision Center" FontSize="27"
                       FontWeight="Bold" Foreground="#172B40"
                       Margin="0,0,0,5" />
            <TextBlock Text="{Binding ProductPromise}" FontSize="14"
                       TextWrapping="Wrap" Foreground="#465F78"
                       Margin="0,0,0,14" />

            <Border Background="#FFF0CA" BorderBrush="#D59A28"
                    BorderThickness="1" CornerRadius="6"
                    Padding="13" Margin="0,0,0,20">
                <TextBlock Text="{Binding DemoNotice}"
                           Foreground="#754400" FontWeight="Bold"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <Border Background="White" BorderBrush="#DDE6EF"
                    BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="¿Quién necesita entender este resultado?"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#203D58" Margin="0,0,0,9" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Vista técnica"
                                Command="{Binding ShowTechnicianExplanationCommand}"
                                Padding="16,9" Margin="0,0,10,0"
                                Background="#E5F0FC" Foreground="#173F64"
                                BorderBrush="#A8CCE8" />
                        <Button Content="Vista para el cliente"
                                Command="{Binding ShowClientExplanationCommand}"
                                Padding="16,9"
                                Background="#F0F4F8" Foreground="#173F64"
                                BorderBrush="#C4D4E1" />
                    </StackPanel>
                    <TextBlock Text="{Binding Explanation.AudienceLabel}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#3B627E" />
                    <TextBlock Text="Solo cambia la explicación; las mediciones y las conclusiones no se modifican."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="#657789" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Elegí un caso para explorar cómo razona el programa"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="#24374C" Margin="0,0,0,12" />

            <UniformGrid Columns="2" Margin="0,0,0,18">
                <Button Content="1 · Faltan datos"
                        Command="{Binding ShowMissingCommand}"
                        Height="46" Margin="0,0,6,8" Padding="12,8"
                        Background="#E8F2FC" Foreground="#17436B"
                        BorderBrush="#B5D5F0" />
                <Button Content="2 · Datos contradictorios"
                        Command="{Binding ShowConflictingCommand}"
                        Height="46" Margin="6,0,0,8" Padding="12,8"
                        Background="#E8F2FC" Foreground="#17436B"
                        BorderBrush="#B5D5F0" />
                <Button Content="3 · Mejoría observada"
                        Command="{Binding ShowImprovementCommand}"
                        Height="46" Margin="0,0,6,8" Padding="12,8"
                        Background="#E8F2FC" Foreground="#17436B"
                        BorderBrush="#B5D5F0" />
                <Button Content="4 · Problema persistente"
                        Command="{Binding ShowUnresolvedCommand}"
                        Height="46" Margin="6,0,0,8" Padding="12,8"
                        Background="#E8F2FC" Foreground="#17436B"
                        BorderBrush="#B5D5F0" />
            </UniformGrid>

            <Border Background="White" BorderBrush="#DDE6EF"
                    BorderThickness="1" CornerRadius="8" Padding="18"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding ScenarioTitle}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#18324F" Margin="0,0,0,7" />
                    <TextBlock Text="{Binding ScenarioDescription}"
                               TextWrapping="Wrap" Foreground="#4B5B6B"
                               FontSize="13" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Explanation.Headline}" FontSize="17"
                       FontWeight="SemiBold" Foreground="#233E58"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F1F6FC"
                        CornerRadius="8" BorderBrush="#D6E3F0"
                        BorderThickness="1" Padding="17">
                    <StackPanel>
                        <TextBlock Text="01 · RESULTADO DE LAS PRUEBAS" FontSize="12"
                                   FontWeight="Bold" Foreground="#42627E"
                                   Margin="0,0,0,7" />
                        <TextBlock Text="{Binding Explanation.DiagnosticText}"
                                   TextWrapping="Wrap" FontSize="15"
                                   Foreground="#1B3044" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Explanation.EvidenceCountText}"
                                   FontSize="12" Foreground="#5D7184" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F1F6FC"
                        CornerRadius="8" BorderBrush="#D6E3F0"
                        BorderThickness="1" Padding="17">
                    <StackPanel>
                        <TextBlock Text="02 · COMPROBACIÓN POSTERIOR" FontSize="12"
                                   FontWeight="Bold" Foreground="#42627E"
                                   Margin="0,0,0,7" />
                        <TextBlock Text="{Binding Explanation.VerificationText}"
                                   TextWrapping="Wrap" FontSize="15"
                                   Foreground="#1B3044" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Explanation.PostcheckCountText}"
                                   FontSize="12" Foreground="#5D7184" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#E8F4EE" BorderBrush="#B9DCC9"
                    BorderThickness="1" CornerRadius="8"
                    Padding="18" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="03 · QUÉ HACER DESPUÉS"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#356751" Margin="0,0,0,7" />
                    <TextBlock Text="{Binding Explanation.NextStepText}"
                               TextWrapping="Wrap" FontSize="16"
                               FontWeight="SemiBold" Foreground="#183E2D" />
                </StackPanel>
            </Border>

            <Border Background="#F3F4F5" BorderBrush="#DDE1E4"
                    BorderThickness="1" CornerRadius="6"
                    Padding="13" Margin="0,0,0,20">
                <TextBlock Text="{Binding Explanation.SafetyNotice}"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="#4C555E" />
            </Border>

            <TextBlock Text="04 · ENTREGA — el Pasaporte Técnico real requiere validar fuentes, revisar privacidad y autorización antes de exportar."
                       FontSize="12" Foreground="#697989"
                       TextWrapping="Wrap" Margin="0,0,0,15" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
