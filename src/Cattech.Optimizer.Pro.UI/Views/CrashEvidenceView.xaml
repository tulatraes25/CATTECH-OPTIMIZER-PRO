<UserControl x:Class="Cattech.Optimizer.Pro.UI.Views.CrashEvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Pantallas azules — evidencia BSOD"
                       FontSize="25" FontWeight="Bold" Foreground="#222222"
                       Margin="0,0,0,4" />
            <TextBlock Text="Solo lectura de metadatos y registro System. DumpChk opcional requiere confirmación expresa."
                       FontSize="12" Foreground="#555555" TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- Acciones técnicas -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Buscar evidencia (solo lectura)"
                        Command="{Binding RefreshCommand}"
                        Padding="16,8" Background="#0078D4" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,8,8" />
                <Button Content="Abrir carpeta de minidumps"
                        Command="{Binding OpenMinidumpFolderCommand}"
                        Padding="12,8"
                        Background="#F3F3F3" Foreground="#333"
                        BorderBrush="#CCC" BorderThickness="1" Cursor="Hand" Margin="0,0,8,8"
                        ToolTip="{Binding DumpsFolderPath}" />
                <Button Content="Abrir Visor de eventos"
                        Command="{Binding OpenEventViewerCommand}"
                        Padding="12,8"
                        Background="#F3F3F3" Foreground="#333"
                        BorderBrush="#CCC" BorderThickness="1" Cursor="Hand" Margin="0,0,8,8" />
                <Button Content="Copiar análisis"
                        Command="{Binding CopyAnalysisCommand}"
                        Padding="12,8"
                        Background="#F3F3F3" Foreground="#333"
                        BorderBrush="#CCC" BorderThickness="1" Cursor="Hand" Margin="0,0,8,8" />
            </WrapPanel>

            <!-- Carpeta de volcados resuelta -->
            <TextBlock Text="{Binding DumpsFolderPath, StringFormat='Carpeta de volcados: {0}'}"
                       FontFamily="Consolas" FontSize="11" Foreground="#666"
                       TextWrapping="Wrap" Margin="0,0,0,2" />
            <TextBlock Text="{Binding DumpFolderStatusText}"
                       FontFamily="Consolas" FontSize="11" Foreground="#666"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- Indicador de ocupado: el comando Refresh se deshabilita solo
                 mientras consulta, sin ignorar clics en silencio. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <ProgressBar Width="110" Height="6" IsIndeterminate="True"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           FontSize="12" Foreground="#333333" />
            </StackPanel>

            <Border Background="#F2F6FA" CornerRadius="6"
                    Padding="10,8" Margin="0,0,0,16">
                <TextBlock Text="{Binding SummaryText}" FontFamily="Consolas"
                           FontSize="11" Foreground="#345068" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="Archivos de volcado" FontSize="17" FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <TextBlock Text="{Binding DumpStatusText}" Foreground="#555555"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding Dumps}"
                      SelectedItem="{Binding SelectedDump, Mode=TwoWay}"
                      SelectionMode="Single" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" Height="180"
                      FontFamily="Consolas" FontSize="11" RowHeight="24"
                      HeadersVisibility="Column" Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*" />
                    <DataGridTextColumn Header="Tamaño (bytes)" Binding="{Binding SizeBytes}" Width="*" />
                    <DataGridTextColumn Header="Última modificación (UTC)"
                                        Binding="{Binding LastModifiedUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                        Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Verificar dump seleccionado con DumpChk (requiere confirmación)"
                    Command="{Binding VerifySelectedDumpCommand}"
                    Padding="14,8" HorizontalAlignment="Left"
                    Background="#F1F1F1" Foreground="#333333"
                    BorderBrush="#B8B8B8" BorderThickness="1"
                    Margin="0,0,0,8" />
            <TextBlock Text="{Binding DumpCheckStatusText}"
                       Foreground="#555555" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="11" Margin="0,0,0,20"/>

            <TextBlock Text="Eventos del sistema relacionados con BugCheck"
                       FontSize="17" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBlock Text="{Binding EventStatusText}" Foreground="#555555"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding Events}" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" Height="190"
                      FontFamily="Consolas" FontSize="11" RowHeight="24"
                      HeadersVisibility="Column" Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha local" Binding="{Binding DateText}" Width="2*" />
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="*" />
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Fuente" Binding="{Binding Source}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Un evento de energía no implica por sí solo pantalla azul. La presencia de un módulo o controlador tampoco confirma su responsabilidad. Solo DumpChk opcional analiza un archivo local tras confirmación explícita; el resultado no determina por sí mismo una causa."
                       Foreground="#777777" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,18"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
