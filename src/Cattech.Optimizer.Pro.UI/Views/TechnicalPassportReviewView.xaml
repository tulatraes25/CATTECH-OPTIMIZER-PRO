<UserControl x:Class="Cattech.Optimizer.Pro.UI.Views.TechnicalPassportReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Pasaporte técnico — revisión previa"
                       FontSize="24" FontWeight="Bold" Foreground="#202020"
                       Margin="0,0,0,9" />
            <TextBlock Text="Vista previa del resumen público, no del informe completo.
                             No se transmite ni guarda ningún archivo desde esta pantalla."
                       TextWrapping="Wrap" FontSize="13" Foreground="#555555"
                       Margin="0,0,0,14" />
            <Border Background="#FFF1DB" CornerRadius="5"
                    Padding="12" Margin="0,0,0,16">
                <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap"
                           Foreground="#704800" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="JSON exacto a revisar" FontWeight="SemiBold"
                       Foreground="#333333" Margin="0,0,0,5" />
            <Border Background="#F4F5F6" CornerRadius="6"
                    BorderBrush="#D9D9D9" BorderThickness="1"
                    Padding="12" Margin="0,0,0,13">
                <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                    <!-- TextBlock deliberately avoids an editable/auto-copy
                         control; sharing requires the command below. -->
                    <TextBlock Text="{Binding PreviewJson}" FontFamily="Consolas"
                               FontSize="12" Foreground="#242424"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <TextBlock Text="Huella SHA-256 del JSON" FontWeight="SemiBold"
                       Foreground="#333333" Margin="0,0,0,5" />
            <TextBlock Text="{Binding PreviewSha256}" FontFamily="Consolas"
                       FontSize="12" Foreground="#555555"
                       TextWrapping="Wrap" Margin="0,0,0,12" />
            <CheckBox Content="Revisé el contenido exacto de esta vista previa."
                      IsChecked="{Binding HasReviewedPreview, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      FontSize="13" Margin="0,0,0,10" />
            <CheckBox Content="Autorizo copiar este JSON al portapapeles de Windows.
                               Entiendo que otras aplicaciones podrían leerlo."
                      IsChecked="{Binding ConsentsToClipboard, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      FontSize="13" Margin="0,0,0,14" />
            <Button Content="Copiar pasaporte revisado al portapapeles"
                    Command="{Binding CopyApprovedPayloadCommand}"
                    HorizontalAlignment="Left" Padding="16,9"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold"
                    Margin="0,0,0,10" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="#555555" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
