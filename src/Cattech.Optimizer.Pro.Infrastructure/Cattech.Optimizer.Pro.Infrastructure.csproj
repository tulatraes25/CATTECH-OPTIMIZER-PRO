<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WMI, Registry, EventLog, native Windows services: Infrastructure is
         Windows-only. Keep Core on net10.0 for portable pure models. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cattech.Optimizer.Pro.Infrastructure</RootNamespace>
    <AssemblyName>Cattech.Optimizer.Pro.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cattech.Optimizer.Pro.Core\Cattech.Optimizer.Pro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cattech.Optimizer.Pro.Core.Tests" />
  </ItemGroup>

</Project>
